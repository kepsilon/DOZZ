module

public import DOZZ.Statements.GMC.IsGaussianL2Limit
import DOZZ.GMC.EquatorGFFCameronMartin

/-! The statement `DOZZ.equatorGFF_cameron_martin`,
proved by `DOZZ.Proofs.equatorGFF_cameron_martin`. -/

public section

open MeasureTheory ProbabilityTheory Filter Topology TopologicalSpace Set
open scoped Distributions ENNReal NNReal

namespace DOZZ

/-- The general cylinder form of Cameron–Martin for the equator GFF. `L` is an `L²` limit of
test evaluations, so the finite-dimensional jointly Gaussian identities extend to the sigma
algebra generated by all evaluations. The shift is multiplied by `t`. See [KRV, Theorem 12.1]
(corrected; erratum K2, see docs/ERRATA-AND-DEVIATIONS.md). -/
theorem equatorGFF_cameron_martin
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (X : Ω → Distr)
    (hX : IsEquatorGFF P X) (L : Ω → ℝ) (hL : IsGaussianL2Limit P X L)
    (t : ℝ) (H : (TestFn → ℝ) → ℝ≥0∞) (hH : Measurable H) :
    (∫⁻ ω,
      ENNReal.ofReal (Real.exp
        (t * L ω - t ^ 2 / 2 * gaussianVariance P L)) *
        H (fun f => X ω f) ∂P) =
    ∫⁻ ω, H (fun f => X ω f +
      t * gaussianCovariance P (fun ω => X ω f) L) ∂P := by exact DOZZ.Proofs.equatorGFF_cameron_martin P X hX L hL t H hH

end DOZZ
