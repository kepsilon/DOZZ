module

public import DOZZ.Statements.Brownian.TwoSidedPath

/-! The statement `DOZZ.brownianPath_measurableSpace_eq_iSup_comap_eval`, proved in this file. -/

public section

open MeasureTheory ProbabilityTheory Filter Topology TopologicalSpace Set
open scoped ENNReal NNReal Topology

namespace DOZZ

/-- The standard compact-open Borel sigma algebra is generated by path evaluations. -/
theorem brownianPath_measurableSpace_eq_iSup_comap_eval :
    (inferInstance : MeasurableSpace BrownianPath) =
      ⨆ t : ℝ≥0, (inferInstance : MeasurableSpace ℝ).comap (fun p : BrownianPath => p t) :=
  ContinuousMap.measurableSpace_eq_iSup_comap_eval

end DOZZ
