module

public import DOZZ.Statements.Brownian.LateralUnitBlockMass

/-! The definition `DOZZ.brownianNaturalSigma`. -/

@[expose] public section

open MeasureTheory ProbabilityTheory Filter Topology TopologicalSpace Set
open scoped ENNReal NNReal Topology

namespace DOZZ

/-- The raw natural sigma algebra generated by Brownian evaluations up to time `t`. -/
@[reducible] def brownianNaturalSigma {Ω : Type*} (B : Ω → BrownianPath)
    (t : ℝ≥0) : MeasurableSpace Ω :=
  ⨆ s : ℝ≥0, ⨆ (_ : s ≤ t), MeasurableSpace.comap (fun ω => B ω s) inferInstance

end DOZZ
