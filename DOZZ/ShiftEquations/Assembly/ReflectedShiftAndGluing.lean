module

public import DOZZ.ShiftEquations.Gluing.ReflectedClosed
public import DOZZ.FourPoint.Crossing.GammaHalfCrossing

/-! Proof of `DOZZ.structureConstant_reflected_shift_and_gluing`: the input
`DOZZ.reflectionR_first_shift_meromorphic` comes from the γ/2 crossing `DOZZ.gammaHalf_crossing`,
`DOZZ.structureConstant_first_shift_strip` from the unreflected formula
`DOZZ.gammaHalf_full_unreflected_formula`, and the diagonal classification
`DOZZ.degenerateFourPoint_diagonal_classification` and the reflected formula
`DOZZ.gammaHalf_reflected_formula` are applied directly. -/

@[expose] public section

open MeasureTheory ProbabilityTheory Filter Topology TopologicalSpace Set
open scoped ENNReal NNReal Topology

namespace DOZZ.Proofs

theorem structureConstant_reflected_shift_and_gluing
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (X : Ω → Distr)
    (M : Ω → Measure ℂ) (γ μ η : ℝ)
    (hγ : 0 < γ) (hγ2 : γ < 2) (hμ : 0 < μ)
    (hη : 0 < η ∧ Q γ - 2 * η > γ)
    (hX : IsEquatorGFF P X) (hM : IsGMCOf P X γ M)
    (α₂ α₃ : ℝ)
    (hα₂ : Q γ - η < α₂ ∧ α₂ < Q γ)
    (hα₃ : Q γ - η < α₃ ∧ α₃ < Q γ) :
    ∃ B : ℝ → Ω → BrownianPath ×
        BrownianPath,
      ∃ Z : Ω → Measure ℝ,
        IsSourceLateralProjection P X γ M Z ∧
          (∀ α : ℝ, γ / 2 < α → α < Q γ →
            IsReflectionData P γ α (B α) Z) ∧
            ∃ h : ℝ, 0 < h ∧ ∃ C R : ℂ → ℂ,
              MeromorphicOn C {z | |z.im| < h} ∧
              MeromorphicOn R {z | |z.im| < h} ∧
              (∀ α : ℝ, 2 * η < α → α < Q γ →
                C (α : ℂ) =
                  (structureConstant P M γ μ α α₂ α₃ : ℂ)) ∧
              (∀ α : ℝ, γ / 2 < α → α < Q γ →
                R (α : ℂ) =
                  (reflectionR P γ μ α (B α) Z : ℂ)) ∧
              (∀ᶠ z in codiscrete ℂ,
                C z = R z * C (2 * Q γ - z)) ∧
              (∀ᶠ z in codiscrete ℂ,
                R (z + γ / 2) * C (2 * Q γ - z - γ / 2) =
                  -(1 / (Real.pi * μ)) * shiftCoeffA γ (γ / 2) z (α₂ : ℂ) (α₃ : ℂ) *
                    C (z - γ / 2)) := by
  exact structureConstant_reflected_shift_and_gluing_of_crossing P X M γ μ η hγ hγ2 hμ hη hX hM α₂ α₃
    hα₂ hα₃ (fun μ' α' ε α hμ' h1 h2 h3 h4 h5 =>
      (gammaHalf_crossing P X M γ μ' α' ε α hγ hγ2 hμ' h1 h2 h3 h4 h5 hX hM).2)

end DOZZ.Proofs

end
