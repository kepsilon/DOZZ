module
public import DOZZ.GFFStructure.CircleContinuity
import Mathlib.Analysis.Convex.Integral
import Mathlib.Analysis.InnerProductSpace.Projection.Basic
import Mathlib.Topology.Sequences
import Mathlib.MeasureTheory.Function.AEEqOfIntegral
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
/-!
# Gaussian Bochner integrals in the given L² space

The closed linear span of one jointly Gaussian family remains Gaussian. Hilbert projections
keep deterministic integrals in that span. Scalar product Fubini identifies the resulting
representative with the literal samplewise integral used in the off-center decomposition.
-/

@[expose] public section

open Filter MeasureTheory ProbabilityTheory Set
open scoped Topology ENNReal NNReal
namespace DOZZ.Proofs
variable {Ω T : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]

/-- The closed Gaussian linear space generated by a jointly Gaussian L² family. -/
noncomputable def gaussianHilbertSpan (Z : T → Lp ℝ 2 P) : Submodule ℝ (Lp ℝ 2 P) :=
  (Submodule.span ℝ (range Z)).topologicalClosure

omit [IsProbabilityMeasure P] in
/-- Every algebraic finite combination in a Gaussian linear space has Gaussian law. -/
theorem hasGaussianLaw_of_mem_span {Z : T → Lp ℝ 2 P}
    (hZ : IsGaussianProcess (fun t => ⇑(Z t)) P) (U : Lp ℝ 2 P)
    (hU : U ∈ Submodule.span ℝ (range Z)) : HasGaussianLaw U P := by
  classical
  obtain ⟨a, ha⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hU
  have he : U = ∑ i : a.support, a i • Z i := by
    rw [← ha]
    simpa only [Finsupp.sum] using (Finset.sum_coe_sort a.support (fun i => a i • Z i)).symm
  rw [he]
  exact (gaussianProcess_linearCombination hZ a.support (fun i => a i)).congr
    (coeFn_L2_linearCombination (fun i : a.support => a i) (fun i => Z i)).symm

/-- L² Gaussian closure applies to every element of the generated closed linear space. -/
theorem hasGaussianLaw_of_mem_gaussianHilbertSpan {Z : T → Lp ℝ 2 P}
    (hZ : IsGaussianProcess (fun t => ⇑(Z t)) P) (U : Lp ℝ 2 P)
    (hU : U ∈ gaussianHilbertSpan Z) : HasGaussianLaw U P := by
  change U ∈ closure (Submodule.span ℝ (range Z) : Set (Lp ℝ 2 P)) at hU
  obtain ⟨u, hu, ht⟩ := mem_closure_iff_seq_limit.mp hU
  exact hasGaussianLaw_of_tendsto_L2 (fun n => hasGaussianLaw_of_mem_span hZ (u n) (hu n)) ht

/-- Arbitrary families in one closed Gaussian linear space remain jointly Gaussian. -/
theorem isGaussianProcess_of_mem_gaussianHilbertSpan {S : Type*} {Z : T → Lp ℝ 2 P}
    (hZ : IsGaussianProcess (fun t => ⇑(Z t)) P) (U : S → Lp ℝ 2 P)
    (hU : ∀ s, U s ∈ gaussianHilbertSpan Z) :
    IsGaussianProcess (fun s => ⇑(U s)) P := by
  classical
  refine ⟨fun I => ?_⟩
  apply hasGaussianLaw_pi_of_linearCombinations
  · intro i
    exact (Lp.aestronglyMeasurable _).aemeasurable
  · intro a
    have hmem : (∑ i : I, a i • U i) ∈ gaussianHilbertSpan Z :=
      Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (hU i))
    exact (hasGaussianLaw_of_mem_gaussianHilbertSpan hZ _ hmem).congr
      (coeFn_L2_linearCombination a (fun i : I => U i))

omit [IsProbabilityMeasure P] in
/-- A coordinate belongs to the Gaussian linear space it generates. -/
theorem mem_gaussianHilbertSpan (Z : T → Lp ℝ 2 P) (t : T) :
    Z t ∈ gaussianHilbertSpan Z :=
  Submodule.le_topologicalClosure _ (Submodule.subset_span (mem_range_self t))

/-- A closed linear subspace contains Bochner integrals for every finite measure. -/
theorem integral_mem_closedSubmodule {A E : Type*} [MeasurableSpace A]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (μ : Measure A) [IsFiniteMeasure μ] (K : Submodule ℝ E)
    (hK : IsClosed (K : Set E)) (F : A → E) (hF : Integrable F μ)
    (hmem : ∀ᵐ a ∂μ, F a ∈ K) : (∫ a, F a ∂μ) ∈ K := by
  by_cases hμ : μ = 0
  · simp only [hμ, integral_zero_measure, Submodule.zero_mem]
  · let _ : NeZero μ := ⟨hμ⟩
    have hav := K.convex.average_mem hK hmem hF
    have h := K.smul_mem (μ.real univ) hav
    rwa [measure_smul_average] at h

omit [IsProbabilityMeasure P] in
/-- Finite-measure integrals stay in the closed Gaussian linear space. -/
theorem integral_mem_gaussianHilbertSpan {A : Type*} [MeasurableSpace A]
    (μ : Measure A) [IsFiniteMeasure μ] (Z : T → Lp ℝ 2 P) (F : A → Lp ℝ 2 P)
    (hF : Integrable F μ) (hmem : ∀ᵐ a ∂μ, F a ∈ gaussianHilbertSpan Z) :
    (∫ a, F a ∂μ) ∈ gaussianHilbertSpan Z :=
  integral_mem_closedSubmodule μ _ (Submodule.isClosed_topologicalClosure _) F hF hmem

/-- Bochner integrals of any family lying in a fixed Gaussian space are Gaussian. -/
theorem hasGaussianLaw_integral_of_mem_gaussianHilbertSpan {A : Type*} [MeasurableSpace A]
    (μ : Measure A) [IsFiniteMeasure μ] {Z : T → Lp ℝ 2 P}
    (hZ : IsGaussianProcess (fun t => ⇑(Z t)) P) (F : A → Lp ℝ 2 P)
    (hF : Integrable F μ) (hmem : ∀ᵐ a ∂μ, F a ∈ gaussianHilbertSpan Z) :
    HasGaussianLaw (⇑(∫ a, F a ∂μ)) P :=
  hasGaussianLaw_of_mem_gaussianHilbertSpan hZ _ (integral_mem_gaussianHilbertSpan μ Z F hF hmem)

omit [IsProbabilityMeasure P] in
/-- Mixed second moments of L² Bochner integrals are the integrals of mixed second moments. -/
theorem integral_mul_L2_integral {A : Type*} [MeasurableSpace A]
    (μ : Measure A) (F : A → Lp ℝ 2 P) (hF : Integrable F μ) (V : Lp ℝ 2 P) :
    (∫ ω, (∫ a, F a ∂μ) ω * V ω ∂P) = ∫ a, ∫ ω, F a ω * V ω ∂P ∂μ := by
  simp_rw [integral_mul_eq_inner]
  have hi := ((innerSL ℝ V).integral_comp_comm hF).symm
  change inner ℝ V (∫ a, F a ∂μ) = ∫ a, inner ℝ V (F a) ∂μ at hi
  simpa only [real_inner_comm V] using hi

/-- Means of L² Bochner integrals commute with integration over the deterministic parameter. -/
theorem integral_mean_L2_integral {A : Type*} [MeasurableSpace A]
    (μ : Measure A) (F : A → Lp ℝ 2 P) (hF : Integrable F μ) :
    (∫ ω, (∫ a, F a ∂μ) ω ∂P) = ∫ a, ∫ ω, F a ω ∂P ∂μ := by
  simp_rw [integral_eq_inner_one]
  let V := Lp.const 2 P (1 : ℝ)
  have hi := ((innerSL ℝ V).integral_comp_comm hF).symm
  change inner ℝ V (∫ a, F a ∂μ) = ∫ a, inner ℝ V (F a) ∂μ at hi
  change inner ℝ (∫ a, F a ∂μ) V = ∫ a, inner ℝ (F a) V ∂μ
  simpa only [real_inner_comm V] using hi

/-- Centering passes from the deterministic parameter family to its L² integral. -/
theorem integral_mean_L2_integral_eq_zero {A : Type*} [MeasurableSpace A]
    (μ : Measure A) (F : A → Lp ℝ 2 P) (hF : Integrable F μ)
    (hzero : ∀ᵐ a ∂μ, (∫ ω, F a ω ∂P) = 0) :
    (∫ ω, (∫ a, F a ∂μ) ω ∂P) = 0 := by
  rw [integral_mean_L2_integral μ F hF]
  exact integral_eq_zero_of_ae hzero

/-- Covariance passes through a centered L² integral. -/
theorem covariance_L2_integral_left {A : Type*} [MeasurableSpace A]
    (μ : Measure A) (F : A → Lp ℝ 2 P) (hF : Integrable F μ) (V : Lp ℝ 2 P)
    (hzero : ∀ a, (∫ ω, F a ω ∂P) = 0) :
    covariance (⇑(∫ a, F a ∂μ)) V P = ∫ a, covariance (F a) V P ∂μ := by
  rw [covariance_L2_eq, integral_mean_L2_integral_eq_zero μ F hF
    (Eventually.of_forall hzero), zero_mul, sub_zero]
  simp_rw [covariance_L2_eq, hzero, zero_mul, sub_zero]
  have hi := ((innerSL ℝ V).integral_comp_comm hF).symm
  change inner ℝ V (∫ a, F a ∂μ) = ∫ a, inner ℝ V (F a) ∂μ at hi
  simpa only [real_inner_comm V] using hi

/-- Closed Hilbert subspaces contain Bochner integrals for arbitrary measures. -/
theorem integral_mem_closedHilbertSubmodule {A E : Type*} [MeasurableSpace A]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (μ : Measure A) (K : Submodule ℝ E) (hK : IsClosed (K : Set E))
    (F : A → E) (hF : Integrable F μ) (hmem : ∀ᵐ a ∂μ, F a ∈ K) :
    (∫ a, F a ∂μ) ∈ K := by
  let _ : CompleteSpace K := hK.completeSpace_coe
  have hae : (fun a => K.starProjection (F a)) =ᵐ[μ] F := by
    filter_upwards [hmem] with a ha
    exact Submodule.starProjection_eq_self_iff.mpr ha
  have hcomm := K.starProjection.integral_comp_comm hF
  rw [integral_congr_ae hae] at hcomm
  have hm := K.starProjection_apply_mem (∫ a, F a ∂μ)
  rwa [← hcomm] at hm

/-- Gaussian Hilbert-space integrals require no finiteness of the parameter measure. -/
theorem hasGaussianLaw_integral {A : Type*} [MeasurableSpace A]
    (μ : Measure A) {Z : T → Lp ℝ 2 P} (hZ : IsGaussianProcess (fun t => ⇑(Z t)) P)
    (F : A → Lp ℝ 2 P) (hF : Integrable F μ)
    (hmem : ∀ᵐ a ∂μ, F a ∈ gaussianHilbertSpan Z) :
    HasGaussianLaw (⇑(∫ a, F a ∂μ)) P :=
  hasGaussianLaw_of_mem_gaussianHilbertSpan hZ _
    (integral_mem_closedHilbertSubmodule μ _ (Submodule.isClosed_topologicalClosure _) F hF hmem)

/-- Circles and smooth tests lifted into their original probability space's L². -/
noncomputable def gffStructureL2Family (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) :
    (ℂ × ℝ) ⊕ TestFn → Lp ℝ 2 P :=
  Sum.elim (circleAverageL2 hc) (fun f => (equatorGFF_test_memLp X hX f).toLp (fun ω => X ω f))

omit [IsProbabilityMeasure P] in
/-- Coordinatewise agreement of the lifted family with the actual circle/test family. -/
theorem gffStructureL2Family_ae_eq (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (j : (ℂ × ℝ) ⊕ TestFn) :
    gffStructureL2Family X Xc hX hc j =ᵐ[P]
      Sum.elim (fun p ω => Xc ω p.1 p.2) (fun f ω => X ω f) j := by
  cases j with
  | inl p => exact circleAverageL2_ae_eq hc p
  | inr f => exact MemLp.coeFn_toLp (equatorGFF_test_memLp X hX f)

omit [IsProbabilityMeasure P] in
/-- The given-space lifted family is jointly Gaussian. -/
theorem gffStructureL2Family_isGaussianProcess (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) :
    IsGaussianProcess (fun j => ⇑(gffStructureL2Family X Xc hX hc j)) P :=
  (circleAverage_tests_isGaussianProcess X Xc hX hc).congr
    (fun j => (gffStructureL2Family_ae_eq X Xc hX hc j).symm)

omit [IsProbabilityMeasure P] in
/-- Multiplying by a compact test removes the radial-coordinate singularity at its center. -/
theorem continuous_testFn_smul_radialL2 (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ : TestFn)
    (hz : z ∉ tsupport ψ) :
    Continuous (fun w : ℂ => ψ w • circleAverageL2 hc (z, -Real.log ‖w - z‖)) := by
  apply continuous_iff_continuousAt.mpr
  intro w
  by_cases hw : w = z
  · subst w
    apply (show ContinuousAt (fun _ : ℂ => (0 : Lp ℝ 2 P)) z from continuousAt_const).congr_of_eventuallyEq
    filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hz] with w hw
    change ψ w = 0 at hw
    rw [hw, zero_smul]
  · have ht : ContinuousAt (fun w : ℂ => (z, -Real.log ‖w - z‖)) w := by
      have hn : ‖w - z‖ ≠ 0 := norm_ne_zero_iff.mpr (sub_ne_zero.mpr hw)
      exact continuousAt_const.prodMk
        (((continuous_id.sub continuous_const).norm.continuousAt.log hn).neg)
    exact ψ.continuous.continuousAt.smul ((continuous_circleAverageL2 P X Xc hX hc).continuousAt.comp ht)

omit [IsProbabilityMeasure P] in
/-- The compact weighted radial map is Bochner integrable in L². -/
theorem integrable_testFn_smul_radialL2 (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ : TestFn)
    (hz : z ∉ tsupport ψ) :
    Integrable (fun w : ℂ => ψ w • circleAverageL2 hc (z, -Real.log ‖w - z‖)) := by
  exact (continuous_testFn_smul_radialL2 X Xc hX hc z ψ hz).integrable_of_hasCompactSupport
    ψ.hasCompactSupport.smul_right

/-- The radial average of a test is a Bochner integral in the original L² carrier. -/
noncomputable def radialIntegralL2 (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ : TestFn) : Lp ℝ 2 P :=
  ∫ w : ℂ, ψ w • circleAverageL2 hc (z, -Real.log ‖w - z‖)

omit [IsProbabilityMeasure P] in
/-- The radial integral lies in the closed Gaussian space of the original circles and tests. -/
theorem radialIntegralL2_mem_gaussianHilbertSpan (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ : TestFn)
    (hz : z ∉ tsupport ψ) :
    radialIntegralL2 X Xc hc z ψ ∈ gaussianHilbertSpan (gffStructureL2Family X Xc hX hc) := by
  apply integral_mem_closedHilbertSubmodule volume _ (Submodule.isClosed_topologicalClosure _) _
    (integrable_testFn_smul_radialL2 X Xc hX hc z ψ hz)
  apply Eventually.of_forall
  intro w
  exact Submodule.smul_mem _ _ (mem_gaussianHilbertSpan _ (Sum.inl (z, -Real.log ‖w - z‖)))

/-- The Bochner radial integral has a Gaussian law. -/
theorem radialIntegralL2_hasGaussianLaw (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ : TestFn)
    (hz : z ∉ tsupport ψ) : HasGaussianLaw (radialIntegralL2 X Xc hc z ψ) P :=
  hasGaussianLaw_of_mem_gaussianHilbertSpan
    (gffStructureL2Family_isGaussianProcess X Xc hX hc) _
    (radialIntegralL2_mem_gaussianHilbertSpan X Xc hX hc z ψ hz)

omit [IsProbabilityMeasure P] in
/-- Scalar multiplication commutes with expectation of an L² representative. -/
theorem integral_mean_L2_smul (a : ℝ) (U : Lp ℝ 2 P) :
    (∫ ω, (a • U) ω ∂P) = a * (∫ ω, U ω ∂P) := by
  rw [integral_congr_ae (Lp.coeFn_smul a U)]
  simpa only [Pi.smul_apply, smul_eq_mul] using integral_const_mul a (fun ω => U ω)

omit [IsProbabilityMeasure P] in
/-- Scalar multiplication commutes with covariance of L² representatives. -/
theorem covariance_L2_smul_left (a : ℝ) (U V : Lp ℝ 2 P) :
    covariance (⇑(a • U)) V P = a * covariance U V P := by
  rw [covariance_congr_ae (Lp.coeFn_smul a U) (EventuallyEq.rfl : (⇑V) =ᵐ[P] V)]
  simpa only [Pi.smul_def, smul_eq_mul] using covariance_const_mul_left a

/-- Bochner radial averages retain the original centering. -/
theorem radialIntegralL2_integral_eq_zero (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ : TestFn)
    (hz : z ∉ tsupport ψ) : (∫ ω, radialIntegralL2 X Xc hc z ψ ω ∂P) = 0 := by
  apply integral_mean_L2_integral_eq_zero volume _
    (integrable_testFn_smul_radialL2 X Xc hX hc z ψ hz)
  apply Eventually.of_forall
  intro w
  rw [integral_mean_L2_smul, circleAverageL2_integral_eq_zero P X Xc hX hc, mul_zero]

/-- Covariance of a radial Bochner average with an arbitrary L² variable. -/
theorem radialIntegralL2_covariance (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ : TestFn)
    (hz : z ∉ tsupport ψ) (V : Lp ℝ 2 P) :
    covariance (radialIntegralL2 X Xc hc z ψ) V P =
      ∫ w : ℂ, ψ w * covariance (circleAverageL2 hc (z, -Real.log ‖w - z‖)) V P := by
  rw [radialIntegralL2, covariance_L2_integral_left volume _
    (integrable_testFn_smul_radialL2 X Xc hX hc z ψ hz) V ?_]
  · simp_rw [covariance_L2_smul_left]
  · intro w
    rw [integral_mean_L2_smul, circleAverageL2_integral_eq_zero P X Xc hX hc, mul_zero]

/-- The radial/circle covariance is the integral of the already identified circle covariance. -/
theorem radialIntegralL2_circle_covariance (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ : TestFn)
    (hz : z ∉ tsupport ψ) (p : ℂ × ℝ) :
    covariance (radialIntegralL2 X Xc hc z ψ) (circleAverageL2 hc p) P =
      ∫ w : ℂ, ψ w * covariance (fun ω => Xc ω z (-Real.log ‖w - z‖))
        (fun ω => Xc ω p.1 p.2) P := by
  rw [radialIntegralL2_covariance X Xc hX hc z ψ hz]
  apply integral_congr_ae
  apply Eventually.of_forall
  intro w
  dsimp only
  rw [covariance_congr_ae (circleAverageL2_ae_eq hc _) (circleAverageL2_ae_eq hc p)]

/-- The radial/test covariance is the integral of the mixed energy `DOZZ.circleCross`. -/
theorem radialIntegralL2_test_covariance (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ f : TestFn)
    (hz : z ∉ tsupport ψ) :
    covariance (radialIntegralL2 X Xc hc z ψ)
      ((equatorGFF_test_memLp X hX f).toLp (fun ω => X ω f)) P =
      ∫ w : ℂ, ψ w * circleCross z (-Real.log ‖w - z‖) f := by
  rw [radialIntegralL2_covariance X Xc hX hc z ψ hz]
  apply integral_congr_ae
  apply Eventually.of_forall
  intro w
  dsimp only
  rw [covariance_congr_ae (circleAverageL2_ae_eq hc _)
    (MemLp.coeFn_toLp (equatorGFF_test_memLp X hX f)), circleAverage_test_covariance P X Xc hX hc]

/-- Two radial test averages have the iterated circle covariance as their covariance. -/
theorem radialIntegralL2_radial_covariance (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ χ : TestFn)
    (hψ : z ∉ tsupport ψ) (hχ : z ∉ tsupport χ) :
    covariance (radialIntegralL2 X Xc hc z ψ) (radialIntegralL2 X Xc hc z χ) P =
      ∫ w : ℂ, ψ w * ∫ v : ℂ, χ v *
        covariance (fun ω => Xc ω z (-Real.log ‖w - z‖))
          (fun ω => Xc ω z (-Real.log ‖v - z‖)) P := by
  rw [radialIntegralL2_covariance X Xc hX hc z ψ hψ]
  apply integral_congr_ae
  apply Eventually.of_forall
  intro w
  dsimp only
  rw [covariance_comm, radialIntegralL2_circle_covariance X Xc hX hc z χ hχ]
  congr 1
  apply integral_congr_ae
  apply Eventually.of_forall
  intro v
  dsimp only
  rw [covariance_comm]

/-- The lateral evaluation in L² subtracts its radial Bochner average from the given test. -/
noncomputable def lateralEvaluationL2 (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ : TestFn) : Lp ℝ 2 P :=
  (equatorGFF_test_memLp X hX ψ).toLp (fun ω => X ω ψ) - radialIntegralL2 X Xc hc z ψ

omit [IsProbabilityMeasure P] in
/-- The off-center lateral evaluation belongs to the original closed Gaussian space. -/
theorem lateralEvaluationL2_mem_gaussianHilbertSpan (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) (ψ : TestFn)
    (hz : z ∉ tsupport ψ) :
    lateralEvaluationL2 X Xc hX hc z ψ ∈ gaussianHilbertSpan (gffStructureL2Family X Xc hX hc) :=
  Submodule.sub_mem _ (mem_gaussianHilbertSpan _ (Sum.inr ψ))
    (radialIntegralL2_mem_gaussianHilbertSpan X Xc hX hc z ψ hz)

/-- The off-center tests in `DOZZ.circleAverage_offCenter_decomposition` avoid the radial singular
point. -/
theorem notMem_tsupport_of_punctured {z : ℂ} {ψ : TestFn}
    (hψ : tsupport ψ ⊆ {w : ℂ | 0 < ‖w - z‖ ∧ ‖w - z‖ < 1}) : z ∉ tsupport ψ := by
  intro hz
  have h := (hψ hz).1
  simp only [sub_self, norm_zero, lt_self_iff_false] at h

/-- The origin of the off-center radial path and all lateral L² evaluations are jointly
Gaussian. Identification with the samplewise integrals is a separate Fubini step. -/
theorem offCenter_lateralL2_isGaussianProcess (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc) (z : ℂ) :
    IsGaussianProcess (fun j : Option {ψ : TestFn //
        tsupport ψ ⊆ {w : ℂ | 0 < ‖w - z‖ ∧ ‖w - z‖ < 1}} =>
      ⇑(j.elim (circleAverageL2 hc (z, 0))
        (fun ψ => lateralEvaluationL2 X Xc hX hc z ψ.val))) P := by
  apply isGaussianProcess_of_mem_gaussianHilbertSpan
    (gffStructureL2Family_isGaussianProcess X Xc hX hc)
  intro j
  cases j with
  | none => exact mem_gaussianHilbertSpan _ (Sum.inl (z, 0))
  | some ψ =>
    exact lateralEvaluationL2_mem_gaussianHilbertSpan X Xc hX hc z ψ.val
      (notMem_tsupport_of_punctured ψ.property)

/-- On a probability space, the L¹ norm of an L² representative is bounded by its L² norm. -/
theorem integral_norm_L2_le (U : Lp ℝ 2 P) : (∫ ω, ‖U ω‖ ∂P) ≤ ‖U‖ := by
  have h := eLpNorm_le_eLpNorm_of_exponent_le (f := (⇑U)) (μ := P)
    (by norm_num : (1 : ℝ≥0∞) ≤ 2)
  rw [integral_norm_eq_lintegral_enorm (Lp.aestronglyMeasurable U),
    ← eLpNorm_one_eq_lintegral_enorm (Lp.aestronglyMeasurable U), Lp.norm_def]
  exact ENNReal.toReal_mono (Lp.memLp U).ne_top h

/-- A jointly measurable representative of an integrable L²-valued family is product
integrable. This proves the Fubini premise rather than assuming it. -/
theorem integrable_L2_representative_prod {A : Type*} [MeasurableSpace A]
    (μ : Measure A) [SFinite μ] (F : A → Lp ℝ 2 P) (hF : Integrable F μ)
    (f : A → Ω → ℝ) (hm : AEStronglyMeasurable (Function.uncurry f) (μ.prod P))
    (heq : ∀ a, (⇑(F a)) =ᵐ[P] f a) : Integrable (Function.uncurry f) (μ.prod P) := by
  apply (integrable_prod_iff hm).mpr
  refine ⟨Eventually.of_forall (fun a => ((Lp.memLp (F a)).integrable (by norm_num)).congr (heq a)), ?_⟩
  apply hF.norm.mono' hm.norm.integral_prod_right'
  apply Eventually.of_forall
  intro a
  rw [Real.norm_eq_abs, abs_of_nonneg (integral_nonneg (fun ω => norm_nonneg (f a ω)))]
  calc
    _ = ∫ ω, ‖F a ω‖ ∂P := integral_congr_ae ((heq a).fun_comp norm).symm
    _ ≤ ‖F a‖ := integral_norm_L2_le (F a)

/-- The representative of the L² Bochner integral agrees almost surely with integration of
any jointly measurable coordinate representatives. -/
theorem L2_integral_ae_eq_integral {A : Type*} [MeasurableSpace A]
    (μ : Measure A) [SFinite μ] (F : A → Lp ℝ 2 P) (hF : Integrable F μ)
    (f : A → Ω → ℝ) (hm : AEStronglyMeasurable (Function.uncurry f) (μ.prod P))
    (heq : ∀ a, (⇑(F a)) =ᵐ[P] f a) :
    (⇑(∫ a, F a ∂μ)) =ᵐ[P] fun ω => ∫ a, f a ω ∂μ := by
  have hi := integrable_L2_representative_prod μ F hF f hm heq
  apply Integrable.ae_eq_of_forall_setIntegral_eq _ _
    ((Lp.memLp _).integrable (by norm_num)) hi.integral_prod_right
  intro s hs hPs
  rw [← L2.inner_indicatorConstLp_one hs hPs.ne]
  let V := indicatorConstLp 2 hs hPs.ne (1 : ℝ)
  have hcomm := (innerSL ℝ V).integral_comp_comm hF
  change (∫ a, inner ℝ V (F a) ∂μ) = inner ℝ V (∫ a, F a ∂μ) at hcomm
  rw [← hcomm]
  have hsection a : inner ℝ V (F a) = ∫ ω in s, f a ω ∂P := by
    rw [L2.inner_indicatorConstLp_one hs hPs.ne]
    exact integral_congr_ae (ae_restrict_of_ae (heq a))
  simp_rw [hsection]
  have his : Integrable (Function.uncurry f) (μ.prod (P.restrict s)) :=
    hi.mono_measure (Measure.prod_mono le_rfl Measure.restrict_le_self)
  exact integral_integral_swap his

/-- Joint measurability identifies the radial Bochner integral with the literal samplewise integral
in `DOZZ.circleAverage_offCenter_decomposition`. -/
theorem radialIntegralL2_ae_eq (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc)
    (hmeas : Measurable (fun p : Ω × (ℂ × ℝ) => Xc p.1 p.2.1 p.2.2))
    (z : ℂ) (ψ : TestFn) (hz : z ∉ tsupport ψ) :
    (⇑(radialIntegralL2 X Xc hc z ψ)) =ᵐ[P]
      fun ω => ∫ w : ℂ, ψ w * Xc ω z (-Real.log ‖w - z‖) := by
  apply L2_integral_ae_eq_integral volume _
    (integrable_testFn_smul_radialL2 X Xc hX hc z ψ hz)
  · apply Measurable.aestronglyMeasurable
    have hcoord : Measurable (fun p : ℂ × Ω => Xc p.2 z (-Real.log ‖p.1 - z‖)) :=
      hmeas.comp (measurable_snd.prodMk (measurable_const.prodMk
        (((measurable_fst.sub measurable_const).norm.log).neg)))
    exact (ψ.continuous.measurable.comp measurable_fst).mul hcoord
  · intro w
    filter_upwards [Lp.coeFn_smul (ψ w) (circleAverageL2 hc (z, -Real.log ‖w - z‖)),
      circleAverageL2_ae_eq hc (z, -Real.log ‖w - z‖)] with ω hsmul hcircle
    rw [hsmul, Pi.smul_apply, smul_eq_mul, hcircle]

/-- The lateral L² representative agrees with the literal test-minus-radial integral. -/
theorem lateralEvaluationL2_ae_eq (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc)
    (hmeas : Measurable (fun p : Ω × (ℂ × ℝ) => Xc p.1 p.2.1 p.2.2))
    (z : ℂ) (ψ : TestFn) (hz : z ∉ tsupport ψ) :
    (⇑(lateralEvaluationL2 X Xc hX hc z ψ)) =ᵐ[P]
      fun ω => X ω ψ - ∫ w : ℂ, ψ w * Xc ω z (-Real.log ‖w - z‖) := by
  filter_upwards [Lp.coeFn_sub
    ((equatorGFF_test_memLp X hX ψ).toLp (fun ω => X ω ψ)) (radialIntegralL2 X Xc hc z ψ),
    MemLp.coeFn_toLp (equatorGFF_test_memLp X hX ψ),
    radialIntegralL2_ae_eq X Xc hX hc hmeas z ψ hz] with ω hsub htest hrad
  rw [lateralEvaluationL2, hsub, Pi.sub_apply, htest, hrad]

/-- The literal off-center origin/lateral family is jointly Gaussian, on the original probability
space. This proves the Gaussian conjunct of `DOZZ.circleAverage_offCenter_decomposition`. -/
theorem offCenter_lateral_isGaussianProcess (X : Ω → Distr) (Xc : Ω → ℂ → ℝ → ℝ)
    (hX : IsEquatorGFF P X) (hc : IsCircleAverage P X Xc)
    (hmeas : Measurable (fun p : Ω × (ℂ × ℝ) => Xc p.1 p.2.1 p.2.2)) (z : ℂ) :
    IsGaussianProcess (fun j : Option {ψ : TestFn //
        tsupport ψ ⊆ {w : ℂ | 0 < ‖w - z‖ ∧ ‖w - z‖ < 1}} => fun ω =>
      j.elim (Xc ω z 0) fun ψ => X ω ψ.val - ∫ w : ℂ, ψ.val w * Xc ω z (-Real.log ‖w - z‖)) P := by
  apply (offCenter_lateralL2_isGaussianProcess X Xc hX hc z).congr
  intro j
  cases j with
  | none => exact circleAverageL2_ae_eq hc (z, 0)
  | some ψ =>
    exact lateralEvaluationL2_ae_eq X Xc hX hc hmeas z ψ.val
      (notMem_tsupport_of_punctured ψ.property)

end DOZZ.Proofs
