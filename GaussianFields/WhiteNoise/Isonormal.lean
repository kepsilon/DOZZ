instance instFact_two_ne_top : Fact ((2 : ℝ≥0∞) ≠ ∞) :=
  ⟨ENNReal.ofNat_ne_top⟩

theorem inner_toLp_real {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    {f g : Ω → ℝ} (hf : MemLp f 2 μ) (hg : MemLp g 2 μ) :
    ⟪hf.toLp f, hg.toLp g⟫_ℝ = ∫ ω, f ω * g ω ∂μ := by
  rw [MeasureTheory.L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards [hf.coeFn_toLp, hg.coeFn_toLp] with ω hfω hgω
  simp [hfω, hgω, mul_comm]

section GaussianL2

variable {ι : Type*}

/-- A single standard Gaussian coordinate as an element of `L²` of the product Gaussian space. -/
@[expose]
noncomputable def gaussianCoordinateLp (i : ι) :
    Lp ℝ 2 (gaussianSequenceMeasure ι) :=
  (memLp_gaussianCoordinate i).toLp (gaussianCoordinate i)

/-- Product Gaussian coordinates are orthonormal in `L²(Ω)`. -/
theorem inner_gaussianCoordinateLp [DecidableEq ι] (i j : ι) :
    ⟪gaussianCoordinateLp i, gaussianCoordinateLp j⟫_ℝ =
      if i = j then 1 else 0 := by
  rw [gaussianCoordinateLp, gaussianCoordinateLp, inner_toLp_real]
  have hcov := covariance_gaussianCoordinate (ι := ι) i j
  rw [covariance_eq_sub (memLp_gaussianCoordinate i) (memLp_gaussianCoordinate j)] at hcov
  simpa [integral_gaussianCoordinate] using hcov

/-- Each Gaussian coordinate has `L²` norm one. -/
theorem norm_gaussianCoordinateLp [DecidableEq ι] (i : ι) :
    ‖gaussianCoordinateLp i‖ = 1 := by
  have hsq : ‖gaussianCoordinateLp i‖ ^ (2 : Nat) = 1 := by
    rw [norm_sq_eq_re_inner (𝕜 := ℝ), inner_gaussianCoordinateLp]
    simp
  exact (sq_eq_sq₀ (norm_nonneg _) zero_le_one).mp (by simpa using hsq)

/-- The concrete Gaussian coordinate vectors form an orthonormal family in `L²(Ω)`. -/
theorem orthonormal_gaussianCoordinateLp [DecidableEq ι] :
    Orthonormal ℝ (fun i : ι => gaussianCoordinateLp i) := by
  classical
  rw [orthonormal_iff_ite]
  intro i j
  exact inner_gaussianCoordinateLp i j

/-- The one-dimensional line generated by a Gaussian coordinate. -/
@[expose]
noncomputable def gaussianCoordinateLine [DecidableEq ι] (i : ι) :
    ℝ →ₗᵢ[ℝ] Lp ℝ 2 (gaussianSequenceMeasure ι) :=
  LinearIsometry.toSpanSingleton ℝ (Lp ℝ 2 (gaussianSequenceMeasure ι))
    (norm_gaussianCoordinateLp i)

@[simp]
theorem gaussianCoordinateLine_apply [DecidableEq ι] (i : ι) (c : ℝ) :
    gaussianCoordinateLine i c = c • gaussianCoordinateLp i :=
  LinearIsometry.toSpanSingleton_apply (norm_gaussianCoordinateLp i) c

/-- The isonormal Gaussian map on `ℓ²(ι)`, constructed as the Hilbert-space sum of independent
standard Gaussian coordinates. -/
@[expose]
noncomputable def gaussianL2Isometry [DecidableEq ι] :
    ℓ²(ι, ℝ) →ₗᵢ[ℝ] Lp ℝ 2 (gaussianSequenceMeasure ι) :=
  (orthonormal_gaussianCoordinateLp (ι := ι)).orthogonalFamily.linearIsometry

@[simp]
theorem gaussianL2Isometry_single [DecidableEq ι] (i : ι) (c : ℝ) :
    gaussianL2Isometry (ι := ι) (lp.single 2 i c) =
      c • gaussianCoordinateLp i := by
  simp [gaussianL2Isometry, LinearIsometry.toSpanSingleton_apply]

/-- The finite set of encoded indices below `n`. -/
@[expose]
noncomputable def gaussianIndexTruncation (ι : Type*) [Encodable ι] [DecidableEq ι]
    (n : ℕ) : Finset ι :=
  (Finset.range n).preimage (Encodable.encode : ι → ℕ) (by
    intro i _ j _ hij
    exact Encodable.encode_injective hij)

theorem tendsto_gaussianIndexTruncation (ι : Type*) [Encodable ι] [DecidableEq ι] :
    Tendsto (gaussianIndexTruncation ι) atTop (atTop : Filter (Finset ι)) := by
  exact (Filter.tendsto_finset_preimage_atTop_atTop
    (f := (Encodable.encode : ι → ℕ)) Encodable.encode_injective).comp
      Filter.tendsto_finset_range

/-- The canonical encoded truncation sets are monotone. -/
theorem gaussianIndexTruncation_subset (ι : Type*) [Encodable ι] [DecidableEq ι]
    {m n : ℕ} (hmn : m ≤ n) :
    gaussianIndexTruncation ι m ⊆ gaussianIndexTruncation ι n := by
  intro i hi
  simp [gaussianIndexTruncation] at hi ⊢
  exact lt_of_lt_of_le hi hmn

/-- The deterministic finite `ℓ²` partial sum over a finite set of indices. -/
@[expose]
noncomputable def gaussianL2CoefficientPartialSum [DecidableEq ι] (s : Finset ι)
    (c : ℓ²(ι, ℝ)) : ℓ²(ι, ℝ) :=
  ∑ i ∈ s, lp.single (E := fun _ : ι => ℝ) 2 i (c i)

theorem norm_gaussianL2CoefficientPartialSum_sq [DecidableEq ι] (s : Finset ι)
    (c : ℓ²(ι, ℝ)) :
    ‖gaussianL2CoefficientPartialSum s c‖ ^ (2 : Nat) =
      ∑ i ∈ s, (c i) ^ (2 : Nat) := by
  have h := lp.norm_sum_single (E := fun _ : ι => ℝ) (p := (2 : ℝ≥0∞))
    (by norm_num : 0 < (2 : ℝ≥0∞).toReal) (fun i => c i) s
  norm_num at h
  simpa [gaussianL2CoefficientPartialSum, Real.norm_eq_abs, sq_abs] using h

/-- Inner product of a finite coefficient projection with the original coefficient vector. -/
theorem inner_gaussianL2CoefficientPartialSum_right [DecidableEq ι] (s : Finset ι)
    (c : ℓ²(ι, ℝ)) :
    ⟪gaussianL2CoefficientPartialSum s c, c⟫_ℝ =
      ∑ i ∈ s, (c i) ^ (2 : Nat) := by
  classical
  unfold gaussianL2CoefficientPartialSum
  rw [sum_inner]
  apply Finset.sum_congr rfl
  intro i _hi
  rw [lp.inner_single_left]
  simp [sq]

/-- Squared deterministic tail norm of a finite coefficient projection. -/
theorem norm_gaussianL2CoefficientPartialSum_sub_sq [DecidableEq ι] (s : Finset ι)
    (c : ℓ²(ι, ℝ)) :
    ‖gaussianL2CoefficientPartialSum s c - c‖ ^ (2 : Nat) =
      ‖c‖ ^ (2 : Nat) - ∑ i ∈ s, (c i) ^ (2 : Nat) := by
  rw [norm_sub_sq_real, inner_gaussianL2CoefficientPartialSum_right,
    norm_gaussianL2CoefficientPartialSum_sq]
  ring

/-- Enlarging a finite coefficient set decreases the squared deterministic tail norm. -/
theorem norm_gaussianL2CoefficientPartialSum_sub_sq_le_of_subset [DecidableEq ι]
    {s t : Finset ι} (hst : s ⊆ t) (c : ℓ²(ι, ℝ)) :
    ‖gaussianL2CoefficientPartialSum t c - c‖ ^ (2 : Nat) ≤
      ‖gaussianL2CoefficientPartialSum s c - c‖ ^ (2 : Nat) := by
  rw [norm_gaussianL2CoefficientPartialSum_sub_sq,
    norm_gaussianL2CoefficientPartialSum_sub_sq]
  have hsum :
      ∑ i ∈ s, (c i) ^ (2 : Nat) ≤ ∑ i ∈ t, (c i) ^ (2 : Nat) :=
    Finset.sum_le_sum_of_subset_of_nonneg hst fun _ _ _ => sq_nonneg _
  linarith

/-- Enlarging a finite coefficient set decreases the deterministic tail norm. -/
theorem norm_gaussianL2CoefficientPartialSum_sub_le_of_subset [DecidableEq ι]
    {s t : Finset ι} (hst : s ⊆ t) (c : ℓ²(ι, ℝ)) :
    ‖gaussianL2CoefficientPartialSum t c - c‖ ≤
      ‖gaussianL2CoefficientPartialSum s c - c‖ := by
  exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
    (norm_gaussianL2CoefficientPartialSum_sub_sq_le_of_subset hst c)

theorem hasSum_gaussianL2CoefficientPartialSum [DecidableEq ι] (c : ℓ²(ι, ℝ)) :
    HasSum (fun i : ι => lp.single (E := fun _ : ι => ℝ) 2 i (c i)) c := by
  simpa using
    (lp.hasSum_single (E := fun _ : ι => ℝ) (p := (2 : ℝ≥0∞))
      ENNReal.ofNat_ne_top c)

theorem tendsto_gaussianL2CoefficientPartialSum [DecidableEq ι] (c : ℓ²(ι, ℝ)) :
    Tendsto (fun s : Finset ι => gaussianL2CoefficientPartialSum s c) atTop (𝓝 c) := by
  simpa [HasSum, gaussianL2CoefficientPartialSum] using
    (hasSum_gaussianL2CoefficientPartialSum c)

theorem tendsto_gaussianL2CoefficientPartialSum_truncation [Encodable ι] [DecidableEq ι]
    (c : ℓ²(ι, ℝ)) :
    Tendsto (fun n : ℕ => gaussianL2CoefficientPartialSum (gaussianIndexTruncation ι n) c)
      atTop (𝓝 c) :=
  (tendsto_gaussianL2CoefficientPartialSum c).comp (tendsto_gaussianIndexTruncation ι)

theorem tendsto_gaussianL2CoefficientPartialSum_truncation_norm_sq [Encodable ι]
    [DecidableEq ι] (c : ℓ²(ι, ℝ)) :
    Tendsto
      (fun n : ℕ => ‖gaussianL2CoefficientPartialSum (gaussianIndexTruncation ι n) c‖ ^
        (2 : Nat))
      atTop (𝓝 (‖c‖ ^ (2 : Nat))) := by
  exact ((continuous_norm.tendsto _).comp
    (tendsto_gaussianL2CoefficientPartialSum_truncation c)).pow 2

theorem tendsto_gaussianLinearCombinationVariance_indexTruncation [Encodable ι] [DecidableEq ι]
    (c : ℓ²(ι, ℝ)) :
    Tendsto
      (fun n : ℕ =>
        (gaussianLinearCombinationVariance (gaussianIndexTruncation ι n) fun i => c i : ℝ))
      atTop (𝓝 (‖c‖ ^ (2 : Nat))) := by
  convert tendsto_gaussianL2CoefficientPartialSum_truncation_norm_sq c using 1
  ext n
  rw [coe_gaussianLinearCombinationVariance, norm_gaussianL2CoefficientPartialSum_sq]

/-- Finite coefficient projection in `ℓ²` is continuous. -/
theorem continuous_gaussianL2CoefficientPartialSum [DecidableEq ι] (s : Finset ι) :
    Continuous (fun c : ℓ²(ι, ℝ) => gaussianL2CoefficientPartialSum s c) := by
  classical
  have hcoord : ∀ i : ι, Continuous fun c : ℓ²(ι, ℝ) => c i := by
    intro i
    rw [Metric.continuous_iff]
    intro c ε hε
    refine ⟨ε, hε, fun y hy => ?_⟩
    calc
      dist (y i) (c i) = ‖(y - c) i‖ := by
        rw [dist_eq_norm]
        rfl
      _ ≤ ‖y - c‖ := lp.norm_apply_le_norm (by norm_num : (2 : ℝ≥0∞) ≠ 0) (y - c) i
      _ = dist y c := by rw [dist_eq_norm]
      _ < ε := hy
  unfold gaussianL2CoefficientPartialSum
  exact continuous_finsetSum _ fun i _ =>
    (lp.singleContinuousLinearMap ℝ (fun _ : ι => ℝ) (2 : ℝ≥0∞) i).continuous.comp
      (hcoord i)

/-- The finite `L²(Ω)` partial sum associated to an `ℓ²` coefficient vector. -/
@[expose]
noncomputable def gaussianPartialSumLp [DecidableEq ι] (s : Finset ι)
    (c : ℓ²(ι, ℝ)) : Lp ℝ 2 (gaussianSequenceMeasure ι) :=
  ∑ i ∈ s, c i • gaussianCoordinateLp i

@[simp]
theorem gaussianPartialSumLp_empty [DecidableEq ι] (c : ℓ²(ι, ℝ)) :
    gaussianPartialSumLp (∅ : Finset ι) c = 0 := by
  simp [gaussianPartialSumLp]

theorem gaussianPartialSumLp_insert [DecidableEq ι] {s : Finset ι} {i : ι}
    (hi : i ∉ s) (c : ℓ²(ι, ℝ)) :
    gaussianPartialSumLp (insert i s) c =
      c i • gaussianCoordinateLp i + gaussianPartialSumLp s c := by
  simp [gaussianPartialSumLp, Finset.sum_insert, hi]

/-- The finite `Lp` partial sum is represented by the corresponding concrete finite Gaussian sum. -/
theorem gaussianPartialSumLp_coeFn [DecidableEq ι] (s : Finset ι)
    (c : ℓ²(ι, ℝ)) :
    ⇑(gaussianPartialSumLp s c) =ᵐ[gaussianSequenceMeasure ι]
      gaussianLinearCombination s (fun i => c i) := by
  classical
  induction s using Finset.induction with
  | empty =>
      filter_upwards [Lp.coeFn_zero ℝ 2 (gaussianSequenceMeasure ι)] with ω hω
      simp [gaussianPartialSumLp, gaussianLinearCombination] at hω ⊢
  | insert i s hi ih =>
      have hsum :
          gaussianPartialSumLp (insert i s) c =
            c i • gaussianCoordinateLp i + gaussianPartialSumLp s c :=
        gaussianPartialSumLp_insert hi c
      rw [hsum]
      filter_upwards [Lp.coeFn_add (c i • gaussianCoordinateLp i)
          (gaussianPartialSumLp s c),
        Lp.coeFn_smul (c i) (gaussianCoordinateLp i),
        (memLp_gaussianCoordinate i).coeFn_toLp,
        ih] with ω hadd hsmul hcoord hih
      rw [hadd]
      change ((c i • gaussianCoordinateLp i : Lp ℝ 2 (gaussianSequenceMeasure ι)) ω +
          (gaussianPartialSumLp s c) ω) =
        gaussianLinearCombination (insert i s) (fun i => c i) ω
      rw [hsmul, hih]
      simp only [Pi.smul_apply, smul_eq_mul]
      unfold gaussianCoordinateLp
      rw [hcoord]
      simp [gaussianLinearCombination, Finset.sum_insert, hi]

/-- A finite Gaussian `L²` partial sum is the isonormal image of the corresponding deterministic
coefficient partial sum. -/
theorem gaussianPartialSumLp_eq_gaussianL2Isometry_coefficientPartialSum [DecidableEq ι]
    (s : Finset ι) (c : ℓ²(ι, ℝ)) :
    gaussianPartialSumLp s c =
      gaussianL2Isometry (ι := ι) (gaussianL2CoefficientPartialSum s c) := by
  classical
  rw [gaussianPartialSumLp, gaussianL2CoefficientPartialSum]
  simp only [map_sum, gaussianL2Isometry_single]

/-- The `L²(Ω)` error of a finite Gaussian partial sum is the deterministic Hilbert-space tail
error of the coefficient vector. -/
theorem norm_gaussianPartialSumLp_sub_gaussianL2Isometry [DecidableEq ι]
    (s : Finset ι) (c : ℓ²(ι, ℝ)) :
    ‖gaussianPartialSumLp s c - gaussianL2Isometry (ι := ι) c‖ =
      ‖gaussianL2CoefficientPartialSum s c - c‖ := by
  rw [gaussianPartialSumLp_eq_gaussianL2Isometry_coefficientPartialSum]
  simpa [map_sub] using
    (gaussianL2Isometry (ι := ι)).norm_map (gaussianL2CoefficientPartialSum s c - c)

/-- Squared `L²(Ω)` error of a finite Gaussian partial sum as a deterministic coefficient-tail
norm. -/
theorem norm_gaussianPartialSumLp_sub_gaussianL2Isometry_sq [DecidableEq ι]
    (s : Finset ι) (c : ℓ²(ι, ℝ)) :
    ‖gaussianPartialSumLp s c - gaussianL2Isometry (ι := ι) c‖ ^ (2 : Nat) =
      ‖gaussianL2CoefficientPartialSum s c - c‖ ^ (2 : Nat) := by
  rw [norm_gaussianPartialSumLp_sub_gaussianL2Isometry]

/-- Finite `Lp` partial sums have the expected centered Gaussian law. -/
theorem map_gaussianPartialSumLp_eq_gaussianReal [DecidableEq ι] (s : Finset ι)
    (c : ℓ²(ι, ℝ)) :
    Measure.map (gaussianPartialSumLp s c) (gaussianSequenceMeasure ι) =
      ProbabilityTheory.gaussianReal 0
        (gaussianLinearCombinationVariance s fun i => c i) := by
  calc
    Measure.map (gaussianPartialSumLp s c) (gaussianSequenceMeasure ι) =
        Measure.map (gaussianLinearCombination s fun i => c i)
          (gaussianSequenceMeasure ι) := by
          exact Measure.map_congr (gaussianPartialSumLp_coeFn s c)
    _ = ProbabilityTheory.gaussianReal 0
        (gaussianLinearCombinationVariance s fun i => c i) :=
          map_gaussianLinearCombination_eq_gaussianReal s fun i => c i

/-- Finite coefficient partial sums converge in `L²(Ω)` to the infinite Gaussian sum. -/
theorem hasSum_gaussianPartialSumLp [DecidableEq ι] (c : ℓ²(ι, ℝ)) :
    HasSum (fun i : ι => c i • gaussianCoordinateLp i)
      (gaussianL2Isometry (ι := ι) c) := by
  rw [gaussianL2Isometry]
  simpa [gaussianCoordinateLine_apply] using
    (orthonormal_gaussianCoordinateLp (ι := ι)).orthogonalFamily.hasSum_linearIsometry c

/-- The finite partial-sum net converges to the infinite white-noise evaluation in `L²(Ω)`. -/
theorem tendsto_gaussianPartialSumLp [DecidableEq ι] (c : ℓ²(ι, ℝ)) :
    Tendsto (fun s : Finset ι => gaussianPartialSumLp s c) atTop
      (𝓝 (gaussianL2Isometry (ι := ι) c)) := by
  simpa [HasSum, gaussianPartialSumLp] using
    (hasSum_gaussianPartialSumLp c)

/-- The infinite Gaussian map preserves inner products on `ℓ²`. -/
theorem inner_gaussianL2Isometry [DecidableEq ι] (c e : ℓ²(ι, ℝ)) :
    ⟪gaussianL2Isometry (ι := ι) c, gaussianL2Isometry (ι := ι) e⟫_ℝ =
      ⟪c, e⟫_ℝ :=
  (gaussianL2Isometry (ι := ι)).inner_map_map c e

@[simp]
theorem norm_gaussianL2Isometry [DecidableEq ι] (c : ℓ²(ι, ℝ)) :
    ‖gaussianL2Isometry (ι := ι) c‖ = ‖c‖ :=
  (gaussianL2Isometry (ι := ι)).norm_map c

/-- Characteristic function of the infinite `ℓ²` Gaussian-coordinate evaluation. -/
theorem charFun_map_gaussianL2Isometry [Encodable ι] [DecidableEq ι]
    (c : ℓ²(ι, ℝ)) (t : ℝ) :
    charFun (Measure.map (gaussianL2Isometry (ι := ι) c) (gaussianSequenceMeasure ι)) t =
      charFun (ProbabilityTheory.gaussianReal 0 (Real.toNNReal (‖c‖ ^ (2 : Nat)))) t := by
  let μ : Measure (GaussianSequenceSpace ι) := gaussianSequenceMeasure ι
  let X : Lp ℝ 2 μ := gaussianL2Isometry (ι := ι) c
  let Xn : ℕ → Lp ℝ 2 μ := fun n =>
    gaussianPartialSumLp (gaussianIndexTruncation ι n) c
  have hLp : Tendsto Xn atTop (𝓝 X) := by
    exact (tendsto_gaussianPartialSumLp c).comp (tendsto_gaussianIndexTruncation ι)
  have hInMeasure : TendstoInMeasure μ (fun n => ⇑(Xn n)) atTop X :=
    tendstoInMeasure_of_tendsto_Lp (p := (2 : ℝ≥0∞)) hLp
  have hDist :
      TendstoInDistribution (fun n => ⇑(Xn n)) atTop (⇑X) (fun _ : ℕ => μ) μ :=
    TendstoInMeasure.tendstoInDistribution hInMeasure fun n =>
      (Lp.aestronglyMeasurable (Xn n)).aemeasurable
  have hWeak :=
    (ProbabilityMeasure.tendsto_iff_forall_integral_rclike_tendsto (Ω := ℝ) ℂ).mp hDist.tendsto
  have hCharLimit :
      Tendsto
        (fun n : ℕ => charFun (Measure.map (Xn n) μ) t)
        atTop
        (𝓝 (charFun (Measure.map X μ) t)) := by
    simpa [charFun_eq_integral_innerProbChar] using
      hWeak (BoundedContinuousFunction.innerProbChar (t : ℝ))
  have hVarianceLimit :
      Tendsto
        (fun n : ℕ =>
          (gaussianLinearCombinationVariance (gaussianIndexTruncation ι n) fun i => c i : ℝ))
        atTop (𝓝 (‖c‖ ^ (2 : Nat))) :=
    tendsto_gaussianLinearCombinationVariance_indexTruncation c
  have hVarianceLimitComplex :
      Tendsto
        (fun n : ℕ =>
          (((gaussianLinearCombinationVariance (gaussianIndexTruncation ι n)
            fun i => c i : ℝ)) : ℂ))
        atTop (𝓝 (((‖c‖ ^ (2 : Nat) : ℝ)) : ℂ)) :=
    (Complex.continuous_ofReal.tendsto _).comp hVarianceLimit
  have hArgumentLimit :
      Tendsto
        (fun n : ℕ =>
          (t : ℂ) * (0 : ℂ) * Complex.I -
            (((gaussianLinearCombinationVariance (gaussianIndexTruncation ι n)
              fun i => c i : ℝ)) : ℂ) * (t : ℂ) ^ (2 : Nat) / 2)
        atTop
        (𝓝 ((t : ℂ) * (0 : ℂ) * Complex.I -
          (((‖c‖ ^ (2 : Nat) : ℝ)) : ℂ) * (t : ℂ) ^ (2 : Nat) / 2)) := by
    exact (tendsto_const_nhds.sub
      ((hVarianceLimitComplex.mul tendsto_const_nhds).div tendsto_const_nhds
        (by norm_num : (2 : ℂ) ≠ 0)))
  have hGaussianLimit :
      Tendsto
        (fun n : ℕ =>
          charFun
            (ProbabilityTheory.gaussianReal 0
              (gaussianLinearCombinationVariance (gaussianIndexTruncation ι n) fun i => c i))
            t)
        atTop
        (𝓝 (charFun
          (ProbabilityTheory.gaussianReal 0 (Real.toNNReal (‖c‖ ^ (2 : Nat)))) t)) := by
    have hExp := (Complex.continuous_exp.tendsto _).comp hArgumentLimit
    simpa [Function.comp_def, ProbabilityTheory.charFun_gaussianReal,
      Real.coe_toNNReal _ (sq_nonneg ‖c‖)] using hExp
  have hFiniteChar :
      Tendsto
        (fun n : ℕ => charFun (Measure.map (Xn n) μ) t)
        atTop
        (𝓝 (charFun
          (ProbabilityTheory.gaussianReal 0 (Real.toNNReal (‖c‖ ^ (2 : Nat)))) t)) := by
    simpa [Xn, μ, map_gaussianPartialSumLp_eq_gaussianReal] using hGaussianLimit
  exact tendsto_nhds_unique hCharLimit hFiniteChar

/-- The infinite `ℓ²` Gaussian-coordinate evaluation is centered Gaussian with variance `‖c‖²`. -/
theorem map_gaussianL2Isometry_eq_gaussianReal [Encodable ι] [DecidableEq ι]
    (c : ℓ²(ι, ℝ)) :
    Measure.map (gaussianL2Isometry (ι := ι) c) (gaussianSequenceMeasure ι) =
      ProbabilityTheory.gaussianReal 0 (Real.toNNReal (‖c‖ ^ (2 : Nat))) := by
  refine Measure.ext_of_charFun ?_
  ext t
  exact charFun_map_gaussianL2Isometry c t

end GaussianL2

section SeparableHilbert

/-- In a separable real Hilbert space, every orthonormal family is countable.  The proof uses
pairwise disjoint balls of radius `1 / 3` around the family. -/
theorem countable_of_orthonormal_of_separable
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [TopologicalSpace.SeparableSpace H]
    {ι : Type*} {v : ι → H} (hv : Orthonormal ℝ v) : Countable ι := by
  classical
  let r : ℝ := 1 / 3
  refine Pairwise.countable_of_isOpen_disjoint
    (s := fun i : ι => Metric.ball (v i) r) ?hd ?ho ?hne
  · intro i j hij
    rw [Function.onFun]
    refine Set.disjoint_left.2 ?_
    intro x hxi hxj
    have hxi' : dist (v i) x < r := by
      simpa [Metric.mem_ball, dist_comm] using hxi
    have hxj' : dist x (v j) < r := by
      simpa [Metric.mem_ball] using hxj
    have hdist_lt : dist (v i) (v j) < 1 := by
      calc
        dist (v i) (v j) ≤ dist (v i) x + dist x (v j) := dist_triangle _ _ _
        _ < r + r := add_lt_add hxi' hxj'
        _ < 1 := by norm_num [r]
    have hinner := orthonormal_iff_ite.mp hv
    have hii : ⟪v i, v i⟫_ℝ = 1 := by simpa using hinner i i
    have hjj : ⟪v j, v j⟫_ℝ = 1 := by simpa using hinner j j
    have hij0 : ⟪v i, v j⟫_ℝ = 0 := by simpa [hij] using hinner i j
    have hnorm_sq : ‖v i - v j‖ ^ (2 : Nat) = 2 := by
      rw [← real_inner_self_eq_norm_sq, real_inner_sub_sub_self, hii, hjj, hij0]
      norm_num
    have hdist_gt : 1 < dist (v i) (v j) := by
      rw [dist_eq_norm]
      nlinarith [norm_nonneg (v i - v j), hnorm_sq]
    linarith
  · intro i
    exact Metric.isOpen_ball
  · intro i
    exact ⟨v i, by simp [r]⟩

end SeparableHilbert

section ScalarWhiteNoise

/-- The deterministic Hilbert space on which scalar white noise over `R^d` is isonormal. -/
noncomputable abbrev ScalarWhiteNoiseHilbert (d : Nat) :=
  Lp ℝ 2 (volume : Measure (Vec d))

/-- The explicit inhomogeneous Haar Hilbert basis of `L²(R^d)`. -/
@[expose]
noncomputable def scalarWhiteNoiseHilbertBasis (d : Nat) :
    HilbertBasis (HaarBasisIndex d) ℝ (ScalarWhiteNoiseHilbert d) :=
  haarHilbertBasis d

theorem scalarWhiteNoiseHilbertBasis_coe (d : Nat) :
    ⇑(scalarWhiteNoiseHilbertBasis d) =
      (haarBasisLp : HaarBasisIndex d → ScalarWhiteNoiseHilbert d) :=
  coe_haarHilbertBasis d

/-- The concrete sample space for scalar white noise over `R^d`. -/
abbrev ScalarWhiteNoiseSpace (d : Nat) :=
  GaussianSequenceSpace (HaarBasisIndex d)

/-- The concrete product probability measure for scalar white noise over `R^d`. -/
@[expose]
noncomputable def scalarWhiteNoiseMeasure (d : Nat) : Measure (ScalarWhiteNoiseSpace d) :=
  gaussianSequenceMeasure (HaarBasisIndex d)

instance instIsProbabilityMeasure_scalarWhiteNoiseMeasure (d : Nat) :
    IsProbabilityMeasure (scalarWhiteNoiseMeasure d) := by
  rw [scalarWhiteNoiseMeasure]
  infer_instance

/-- Scalar white noise as a concrete linear isometry from `L²(R^d)` to `L²(Ω)`. -/
@[expose]
noncomputable def scalarWhiteNoiseL2 (d : Nat) :
    ScalarWhiteNoiseHilbert d →ₗᵢ[ℝ] Lp ℝ 2 (scalarWhiteNoiseMeasure d) :=
  (gaussianL2Isometry (ι := HaarBasisIndex d)).comp
    (scalarWhiteNoiseHilbertBasis d).repr.toLinearIsometry

/-- Scalar white noise preserves the `L²(R^d)` inner product. -/
theorem inner_scalarWhiteNoiseL2 {d : Nat}
    (f g : ScalarWhiteNoiseHilbert d) :
    ⟪scalarWhiteNoiseL2 d f, scalarWhiteNoiseL2 d g⟫_ℝ = ⟪f, g⟫_ℝ :=
  (scalarWhiteNoiseL2 d).inner_map_map f g

@[simp]
theorem norm_scalarWhiteNoiseL2 {d : Nat} (f : ScalarWhiteNoiseHilbert d) :
    ‖scalarWhiteNoiseL2 d f‖ = ‖f‖ :=
  (scalarWhiteNoiseL2 d).norm_map f

/-- The scalar white-noise evaluation of any `L²(R^d)` vector is centered Gaussian with variance
its squared `L²` norm. -/
theorem map_scalarWhiteNoiseL2_eq_gaussianReal {d : Nat}
    (f : ScalarWhiteNoiseHilbert d) :
    Measure.map (scalarWhiteNoiseL2 d f) (scalarWhiteNoiseMeasure d) =
      ProbabilityTheory.gaussianReal 0 (Real.toNNReal (‖f‖ ^ (2 : Nat))) := by
  change Measure.map
      (gaussianL2Isometry (ι := HaarBasisIndex d)
        ((scalarWhiteNoiseHilbertBasis d).repr.toLinearIsometry f))
      (gaussianSequenceMeasure (HaarBasisIndex d)) =
    ProbabilityTheory.gaussianReal 0 (Real.toNNReal (‖f‖ ^ (2 : Nat)))
  rw [map_gaussianL2Isometry_eq_gaussianReal]
  rw [((scalarWhiteNoiseHilbertBasis d).repr.toLinearIsometry).norm_map f]

/-- Scalar white-noise evaluations have mean zero. -/
theorem integral_scalarWhiteNoiseL2 {d : Nat} (f : ScalarWhiteNoiseHilbert d) :
    ∫ ω, scalarWhiteNoiseL2 d f ω ∂scalarWhiteNoiseMeasure d = 0 := by
  let v : ℝ≥0 := Real.toNNReal (‖f‖ ^ (2 : Nat))
  have hLaw : HasLaw (scalarWhiteNoiseL2 d f) (ProbabilityTheory.gaussianReal 0 v)
      (scalarWhiteNoiseMeasure d) := by
    refine ⟨?_, ?_⟩
    · exact (Lp.aestronglyMeasurable (scalarWhiteNoiseL2 d f)).aemeasurable
    · dsimp [v]
      exact map_scalarWhiteNoiseL2_eq_gaussianReal f
  calc
    ∫ ω, scalarWhiteNoiseL2 d f ω ∂scalarWhiteNoiseMeasure d =
        ∫ z : ℝ, z ∂ProbabilityTheory.gaussianReal 0 v := hLaw.integral_eq
    _ = 0 := by
        exact ProbabilityTheory.integral_id_gaussianReal (μ := 0) (v := v)

/-- The product integral of two scalar white-noise evaluations is the deterministic `L²` inner
product. -/
theorem integral_mul_scalarWhiteNoiseL2 {d : Nat}
    (f g : ScalarWhiteNoiseHilbert d) :
    ∫ ω, scalarWhiteNoiseL2 d f ω * scalarWhiteNoiseL2 d g ω
        ∂scalarWhiteNoiseMeasure d =
      ⟪f, g⟫_ℝ := by
  rw [← inner_scalarWhiteNoiseL2 f g, MeasureTheory.L2.inner_def]
  apply integral_congr_ae
  filter_upwards with ω
  simp [mul_comm]

/-- Scalar white noise has covariance equal to the deterministic `L²` inner product. -/
theorem covariance_scalarWhiteNoiseL2 {d : Nat}
    (f g : ScalarWhiteNoiseHilbert d) :
    cov[scalarWhiteNoiseL2 d f, scalarWhiteNoiseL2 d g; scalarWhiteNoiseMeasure d] =
      ⟪f, g⟫_ℝ := by
  rw [ProbabilityTheory.covariance_eq_sub (Lp.memLp (scalarWhiteNoiseL2 d f))
    (Lp.memLp (scalarWhiteNoiseL2 d g))]
  change (∫ x, scalarWhiteNoiseL2 d f x * scalarWhiteNoiseL2 d g x
        ∂scalarWhiteNoiseMeasure d) -
      (∫ x, scalarWhiteNoiseL2 d f x ∂scalarWhiteNoiseMeasure d) *
        (∫ x, scalarWhiteNoiseL2 d g x ∂scalarWhiteNoiseMeasure d) =
    ⟪f, g⟫_ℝ
  rw [integral_mul_scalarWhiteNoiseL2, integral_scalarWhiteNoiseL2,
    integral_scalarWhiteNoiseL2]
  ring

theorem aemeasurable_scalarWhiteNoiseL2 {d : Nat} (f : ScalarWhiteNoiseHilbert d) :
    AEMeasurable (scalarWhiteNoiseL2 d f) (scalarWhiteNoiseMeasure d) :=
  (Lp.aestronglyMeasurable (scalarWhiteNoiseL2 d f)).aemeasurable

theorem aemeasurable_pair_scalarWhiteNoiseL2 {d : Nat}
    (f g : ScalarWhiteNoiseHilbert d) :
    AEMeasurable
      (fun ω =>
        WithLp.toLp 2 (scalarWhiteNoiseL2 d f ω, scalarWhiteNoiseL2 d g ω))
      (scalarWhiteNoiseMeasure d) := by
  exact (MeasurableEquiv.toLp 2 (ℝ × ℝ)).measurable.aemeasurable.comp_aemeasurable
    ((aemeasurable_scalarWhiteNoiseL2 f).prodMk (aemeasurable_scalarWhiteNoiseL2 g))

theorem aemeasurable_scalarWhiteNoiseL2_linearCombination {d : Nat}
    (f g : ScalarWhiteNoiseHilbert d) (a b : ℝ) :
    AEMeasurable
      (fun ω => a * scalarWhiteNoiseL2 d f ω + b * scalarWhiteNoiseL2 d g ω)
      (scalarWhiteNoiseMeasure d) := by
  exact ((aemeasurable_scalarWhiteNoiseL2 f).const_mul a).add
    ((aemeasurable_scalarWhiteNoiseL2 g).const_mul b)

theorem scalarWhiteNoiseL2_linearCombination_ae {d : Nat}
    (f g : ScalarWhiteNoiseHilbert d) (a b : ℝ) :
    (fun ω => a * scalarWhiteNoiseL2 d f ω + b * scalarWhiteNoiseL2 d g ω) =ᵐ[
      scalarWhiteNoiseMeasure d]
      fun ω => scalarWhiteNoiseL2 d (a • f + b • g) ω := by
  have hLp : scalarWhiteNoiseL2 d (a • f + b • g) =
      a • scalarWhiteNoiseL2 d f + b • scalarWhiteNoiseL2 d g := by
    simp [map_add, map_smul]
  rw [hLp]
  filter_upwards
    [Lp.coeFn_add (a • scalarWhiteNoiseL2 d f) (b • scalarWhiteNoiseL2 d g),
      Lp.coeFn_smul a (scalarWhiteNoiseL2 d f),
      Lp.coeFn_smul b (scalarWhiteNoiseL2 d g)] with ω hadd ha hb
  rw [hadd]
  simp only [Pi.add_apply]
  rw [ha, hb]
  simp only [Pi.smul_apply, smul_eq_mul]

theorem aemeasurable_scalarWhiteNoiseL2_finset_linearCombination {d : Nat} {ι : Type*}
    (s : Finset ι) (a : ι → ℝ) (f : ι → ScalarWhiteNoiseHilbert d) :
    AEMeasurable
      (fun ω => ∑ i ∈ s, a i * scalarWhiteNoiseL2 d (f i) ω)
      (scalarWhiteNoiseMeasure d) := by
  classical
  exact Finset.aemeasurable_fun_sum s fun i _ =>
    (aemeasurable_scalarWhiteNoiseL2 (f i)).const_mul (a i)

theorem scalarWhiteNoiseL2_finset_linearCombination_ae {d : Nat} {ι : Type*}
    (s : Finset ι) (a : ι → ℝ) (f : ι → ScalarWhiteNoiseHilbert d) :
    (fun ω => ∑ i ∈ s, a i * scalarWhiteNoiseL2 d (f i) ω) =ᵐ[
      scalarWhiteNoiseMeasure d]
      fun ω => scalarWhiteNoiseL2 d (∑ i ∈ s, a i • f i) ω := by
  classical
  have hLp :
      (∑ i ∈ s, a i • scalarWhiteNoiseL2 d (f i)) =
        scalarWhiteNoiseL2 d (∑ i ∈ s, a i • f i) := by
    simp [map_sum]
  have hcoe :
      (fun ω =>
        (∑ i ∈ s, a i • scalarWhiteNoiseL2 d (f i) :
          Lp ℝ 2 (scalarWhiteNoiseMeasure d)) ω) =ᵐ[scalarWhiteNoiseMeasure d]
        fun ω => ∑ i ∈ s, a i * scalarWhiteNoiseL2 d (f i) ω := by
    refine Finset.induction_on s ?_ ?_
    · simp
    · intro i s his hs
      have hadd :
          (fun ω =>
            (a i • scalarWhiteNoiseL2 d (f i) +
              ∑ j ∈ s, a j • scalarWhiteNoiseL2 d (f j) :
              Lp ℝ 2 (scalarWhiteNoiseMeasure d)) ω) =ᵐ[scalarWhiteNoiseMeasure d]
            fun ω =>
              (a i • scalarWhiteNoiseL2 d (f i)) ω +
                (∑ j ∈ s, a j • scalarWhiteNoiseL2 d (f j) :
                  Lp ℝ 2 (scalarWhiteNoiseMeasure d)) ω :=
        Lp.coeFn_add (a i • scalarWhiteNoiseL2 d (f i))
          (∑ j ∈ s, a j • scalarWhiteNoiseL2 d (f j))
      have hsmul :
          (fun ω => (a i • scalarWhiteNoiseL2 d (f i)) ω) =ᵐ[
            scalarWhiteNoiseMeasure d]
            fun ω => a i * scalarWhiteNoiseL2 d (f i) ω :=
        Lp.coeFn_smul (a i) (scalarWhiteNoiseL2 d (f i))
      filter_upwards [hadd, hsmul, hs] with ω haddω hsmulω hsω
      simp only [Finset.sum_insert, his, not_false_eq_true]
      rw [haddω, hsmulω, hsω]
  rw [← hLp]
  exact hcoe.symm

theorem charFun_scalarWhiteNoiseL2_linearCombination {d : Nat}
    (f g : ScalarWhiteNoiseHilbert d) (a b : ℝ) :
    charFun
      (Measure.map
        (fun ω => a * scalarWhiteNoiseL2 d f ω + b * scalarWhiteNoiseL2 d g ω)
        (scalarWhiteNoiseMeasure d)) 1 =
      charFun
      (ProbabilityTheory.gaussianReal 0
        (Real.toNNReal (‖a • f + b • g‖ ^ (2 : Nat)))) 1 := by
  rw [Measure.map_congr (scalarWhiteNoiseL2_linearCombination_ae f g a b)]
  rw [map_scalarWhiteNoiseL2_eq_gaussianReal]

theorem charFun_scalarWhiteNoiseL2_finset_linearCombination {d : Nat} {ι : Type*}
    (s : Finset ι) (a : ι → ℝ) (f : ι → ScalarWhiteNoiseHilbert d) :
    charFun
      (Measure.map
        (fun ω => ∑ i ∈ s, a i * scalarWhiteNoiseL2 d (f i) ω)
        (scalarWhiteNoiseMeasure d)) 1 =
      charFun
        (ProbabilityTheory.gaussianReal 0
          (Real.toNNReal (‖∑ i ∈ s, a i • f i‖ ^ (2 : Nat)))) 1 := by
  rw [Measure.map_congr (scalarWhiteNoiseL2_finset_linearCombination_ae s a f)]
  rw [map_scalarWhiteNoiseL2_eq_gaussianReal]

theorem aemeasurable_pi_scalarWhiteNoiseL2 {d : Nat} {ι : Type*} [Fintype ι]
    (f : ι → ScalarWhiteNoiseHilbert d) :
    AEMeasurable
      (fun ω => WithLp.toLp 2 (fun i : ι => scalarWhiteNoiseL2 d (f i) ω))
      (scalarWhiteNoiseMeasure d) := by
  exact (MeasurableEquiv.toLp 2 ((i : ι) → ℝ)).measurable.aemeasurable.comp_aemeasurable
    (aemeasurable_pi_iff.2 fun i => aemeasurable_scalarWhiteNoiseL2 (f i))

theorem charFun_pi_scalarWhiteNoiseL2 {d : Nat} {ι : Type*} [Fintype ι]
    (f : ι → ScalarWhiteNoiseHilbert d) (t : PiLp 2 fun _ : ι => ℝ) :
    charFun
      (Measure.map
        (fun ω => WithLp.toLp 2 (fun i : ι => scalarWhiteNoiseL2 d (f i) ω))
        (scalarWhiteNoiseMeasure d)) t =
      charFun
        (ProbabilityTheory.gaussianReal 0
          (Real.toNNReal (‖∑ i, t i • f i‖ ^ (2 : Nat)))) 1 := by
  classical
  calc
    charFun
        (Measure.map
          (fun ω => WithLp.toLp 2 (fun i : ι => scalarWhiteNoiseL2 d (f i) ω))
          (scalarWhiteNoiseMeasure d)) t
        = charFun
          (Measure.map
            (fun ω => ∑ i, t i * scalarWhiteNoiseL2 d (f i) ω)
            (scalarWhiteNoiseMeasure d)) 1 := by
          rw [charFun_apply, charFun_apply]
          rw [integral_map (aemeasurable_pi_scalarWhiteNoiseL2 f)]
          · rw [integral_map
              (aemeasurable_scalarWhiteNoiseL2_finset_linearCombination
                (Finset.univ : Finset ι) (fun i => t i) f)]
            · apply integral_congr_ae
              filter_upwards with ω
              simp [PiLp.inner_apply, RCLike.inner_apply, mul_comm]
            · fun_prop
          · fun_prop
    _ = charFun
        (ProbabilityTheory.gaussianReal 0
          (Real.toNNReal (‖∑ i, t i • f i‖ ^ (2 : Nat)))) 1 := by
        simpa using
          charFun_scalarWhiteNoiseL2_finset_linearCombination
            (d := d) (Finset.univ : Finset ι) (fun i => t i) f

theorem aemeasurable_pair_pi_scalarWhiteNoiseL2 {d : Nat} {ι κ : Type*}
    [Fintype ι] [Fintype κ]
    (f : ι → ScalarWhiteNoiseHilbert d) (g : κ → ScalarWhiteNoiseHilbert d) :
    AEMeasurable
      (fun ω =>
        WithLp.toLp 2
          (WithLp.toLp 2 (fun i : ι => scalarWhiteNoiseL2 d (f i) ω),
            WithLp.toLp 2 (fun j : κ => scalarWhiteNoiseL2 d (g j) ω)))
      (scalarWhiteNoiseMeasure d) := by
  exact (MeasurableEquiv.toLp 2
      (PiLp 2 (fun _ : ι => ℝ) × PiLp 2 (fun _ : κ => ℝ))).measurable.aemeasurable
    |>.comp_aemeasurable
      ((aemeasurable_pi_scalarWhiteNoiseL2 f).prodMk
        (aemeasurable_pi_scalarWhiteNoiseL2 g))

theorem charFun_scalarWhiteNoiseL2_two_fintype_linearCombination {d : Nat}
    {ι κ : Type*} [Fintype ι] [Fintype κ]
    (a : ι → ℝ) (b : κ → ℝ)
    (f : ι → ScalarWhiteNoiseHilbert d) (g : κ → ScalarWhiteNoiseHilbert d) :
    charFun
      (Measure.map
        (fun ω =>
          (∑ i, a i * scalarWhiteNoiseL2 d (f i) ω) +
            ∑ j, b j * scalarWhiteNoiseL2 d (g j) ω)
        (scalarWhiteNoiseMeasure d)) 1 =
      charFun
        (ProbabilityTheory.gaussianReal 0
          (Real.toNNReal
            (‖(∑ i, a i • f i) + ∑ j, b j • g j‖ ^ (2 : Nat)))) 1 := by
  classical
  let c : Sum ι κ → ℝ := Sum.elim a b
  let h : Sum ι κ → ScalarWhiteNoiseHilbert d := Sum.elim f g
  simpa [c, h, Fintype.sum_sum_type] using
    charFun_scalarWhiteNoiseL2_finset_linearCombination
      (d := d) (Finset.univ : Finset (Sum ι κ)) c h

theorem charFun_pair_pi_scalarWhiteNoiseL2 {d : Nat} {ι κ : Type*}
    [Fintype ι] [Fintype κ]
    (f : ι → ScalarWhiteNoiseHilbert d) (g : κ → ScalarWhiteNoiseHilbert d)
    (t : WithLp 2 (PiLp 2 (fun _ : ι => ℝ) × PiLp 2 (fun _ : κ => ℝ))) :
    charFun
      (Measure.map
        (fun ω =>
          WithLp.toLp 2
            (WithLp.toLp 2 (fun i : ι => scalarWhiteNoiseL2 d (f i) ω),
              WithLp.toLp 2 (fun j : κ => scalarWhiteNoiseL2 d (g j) ω)))
        (scalarWhiteNoiseMeasure d)) t =
      charFun
        (ProbabilityTheory.gaussianReal 0
          (Real.toNNReal
            (‖(∑ i, (WithLp.ofLp t).1 i • f i) +
                ∑ j, (WithLp.ofLp t).2 j • g j‖ ^ (2 : Nat)))) 1 := by
  classical
  let a : PiLp 2 (fun _ : ι => ℝ) := (WithLp.ofLp t).1
  let b : PiLp 2 (fun _ : κ => ℝ) := (WithLp.ofLp t).2
  have hsumMeas :
      AEMeasurable
        (fun ω =>
          (∑ i, a i * scalarWhiteNoiseL2 d (f i) ω) +
            ∑ j, b j * scalarWhiteNoiseL2 d (g j) ω)
        (scalarWhiteNoiseMeasure d) :=
    (aemeasurable_scalarWhiteNoiseL2_finset_linearCombination
      (Finset.univ : Finset ι) (fun i => a i) f).add
      (aemeasurable_scalarWhiteNoiseL2_finset_linearCombination
        (Finset.univ : Finset κ) (fun j => b j) g)
  calc
    charFun
        (Measure.map
          (fun ω =>
            WithLp.toLp 2
              (WithLp.toLp 2 (fun i : ι => scalarWhiteNoiseL2 d (f i) ω),
                WithLp.toLp 2 (fun j : κ => scalarWhiteNoiseL2 d (g j) ω)))
          (scalarWhiteNoiseMeasure d)) t
        = charFun
          (Measure.map
            (fun ω =>
              (∑ i, a i * scalarWhiteNoiseL2 d (f i) ω) +
                ∑ j, b j * scalarWhiteNoiseL2 d (g j) ω)
          (scalarWhiteNoiseMeasure d)) 1 := by
          rw [charFun_apply, charFun_apply]
          rw [integral_map (aemeasurable_pair_pi_scalarWhiteNoiseL2 f g)]
          · rw [integral_map hsumMeas]
            · apply integral_congr_ae
              filter_upwards with ω
              simp only [WithLp.prod_inner_apply, PiLp.inner_apply, RCLike.inner_apply,
                conj_trivial, one_mul]
              dsimp only [a, b]
            · fun_prop
          · fun_prop
    _ = charFun
        (ProbabilityTheory.gaussianReal 0
          (Real.toNNReal
            (‖(∑ i, (WithLp.ofLp t).1 i • f i) +
                ∑ j, (WithLp.ofLp t).2 j • g j‖ ^ (2 : Nat)))) 1 := by
        simpa [a, b] using
          charFun_scalarWhiteNoiseL2_two_fintype_linearCombination
            (d := d) (fun i : ι => a i) (fun j : κ => b j) f g

theorem charFun_gaussianReal_toNNReal_add_sq_eq_mul {A B : ℝ}
    (hA : 0 ≤ A) (hB : 0 ≤ B) :
    charFun (ProbabilityTheory.gaussianReal 0 (Real.toNNReal (A + B))) 1 =
      charFun (ProbabilityTheory.gaussianReal 0 (Real.toNNReal A)) 1 *
        charFun (ProbabilityTheory.gaussianReal 0 (Real.toNNReal B)) 1 := by
  have hAB : 0 ≤ A + B := add_nonneg hA hB
  rw [ProbabilityTheory.charFun_gaussianReal,
    ProbabilityTheory.charFun_gaussianReal,
    ProbabilityTheory.charFun_gaussianReal]
  rw [Real.coe_toNNReal _ hAB, Real.coe_toNNReal _ hA, Real.coe_toNNReal _ hB]
  simp only [Complex.ofReal_zero, Complex.ofReal_one, zero_mul, one_mul]
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem norm_add_sq_of_inner_eq_zero
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (x y : H) (hxy : ⟪x, y⟫_ℝ = 0) :
    ‖x + y‖ ^ (2 : Nat) = ‖x‖ ^ (2 : Nat) + ‖y‖ ^ (2 : Nat) := by
  rw [norm_add_sq_real, hxy]
  ring

theorem indepFun_pi_scalarWhiteNoiseL2_of_forall_inner_eq_zero {d : Nat}
    {ι κ : Type*} [Fintype ι] [Fintype κ]
    (f : ι → ScalarWhiteNoiseHilbert d) (g : κ → ScalarWhiteNoiseHilbert d)
    (hfg : ∀ i j, ⟪f i, g j⟫_ℝ = 0) :
    (fun ω => WithLp.toLp 2 (fun i : ι => scalarWhiteNoiseL2 d (f i) ω))
      ⟂ᵢ[scalarWhiteNoiseMeasure d]
    (fun ω => WithLp.toLp 2 (fun j : κ => scalarWhiteNoiseL2 d (g j) ω)) := by
  classical
  rw [indepFun_iff_charFun_prod (aemeasurable_pi_scalarWhiteNoiseL2 f)
    (aemeasurable_pi_scalarWhiteNoiseL2 g)]
  intro t
  let a : PiLp 2 (fun _ : ι => ℝ) := (WithLp.ofLp t).1
  let b : PiLp 2 (fun _ : κ => ℝ) := (WithLp.ofLp t).2
  have hinner :
      ⟪(∑ i, a i • f i), (∑ j, b j • g j)⟫_ℝ = 0 := by
    rw [sum_inner]
    apply Finset.sum_eq_zero
    intro i _hi
    rw [inner_sum]
    apply Finset.sum_eq_zero
    intro j _hj
    rw [real_inner_smul_left, real_inner_smul_right, hfg i j]
    ring
  have hnorm :
      ‖(∑ i, a i • f i) + ∑ j, b j • g j‖ ^ (2 : Nat) =
        ‖∑ i, a i • f i‖ ^ (2 : Nat) +
          ‖∑ j, b j • g j‖ ^ (2 : Nat) :=
    norm_add_sq_of_inner_eq_zero _ _ hinner
  have hA : 0 ≤ ‖∑ i, a i • f i‖ ^ (2 : Nat) := sq_nonneg _
  have hB : 0 ≤ ‖∑ j, b j • g j‖ ^ (2 : Nat) := sq_nonneg _
  change
    charFun
      (Measure.map
        (fun ω =>
          WithLp.toLp 2
            (WithLp.toLp 2 (fun i : ι => scalarWhiteNoiseL2 d (f i) ω),
              WithLp.toLp 2 (fun j : κ => scalarWhiteNoiseL2 d (g j) ω)))
        (scalarWhiteNoiseMeasure d)) t =
      charFun
        (Measure.map
          (fun ω => WithLp.toLp 2 (fun i : ι => scalarWhiteNoiseL2 d (f i) ω))
          (scalarWhiteNoiseMeasure d)) a *
        charFun
          (Measure.map
            (fun ω => WithLp.toLp 2 (fun j : κ => scalarWhiteNoiseL2 d (g j) ω))
            (scalarWhiteNoiseMeasure d)) b
  calc
    charFun
        (Measure.map
          (fun ω =>
            WithLp.toLp 2
              (WithLp.toLp 2 (fun i : ι => scalarWhiteNoiseL2 d (f i) ω),
                WithLp.toLp 2 (fun j : κ => scalarWhiteNoiseL2 d (g j) ω)))
          (scalarWhiteNoiseMeasure d)) t
        = charFun
          (ProbabilityTheory.gaussianReal 0
            (Real.toNNReal
              (‖(∑ i, a i • f i) + ∑ j, b j • g j‖ ^ (2 : Nat)))) 1 := by
          simpa [a, b] using charFun_pair_pi_scalarWhiteNoiseL2 f g t
    _ = charFun
          (ProbabilityTheory.gaussianReal 0
            (Real.toNNReal
              (‖∑ i, a i • f i‖ ^ (2 : Nat) +
                ‖∑ j, b j • g j‖ ^ (2 : Nat)))) 1 := by
          rw [hnorm]
    _ = charFun
          (ProbabilityTheory.gaussianReal 0
            (Real.toNNReal (‖∑ i, a i • f i‖ ^ (2 : Nat)))) 1 *
        charFun
          (ProbabilityTheory.gaussianReal 0
            (Real.toNNReal (‖∑ j, b j • g j‖ ^ (2 : Nat)))) 1 :=
          charFun_gaussianReal_toNNReal_add_sq_eq_mul hA hB
    _ = charFun
          (Measure.map
            (fun ω => WithLp.toLp 2 (fun i : ι => scalarWhiteNoiseL2 d (f i) ω))
            (scalarWhiteNoiseMeasure d)) a *
        charFun
          (Measure.map
            (fun ω => WithLp.toLp 2 (fun j : κ => scalarWhiteNoiseL2 d (g j) ω))
            (scalarWhiteNoiseMeasure d)) b := by
          rw [charFun_pi_scalarWhiteNoiseL2 f a, charFun_pi_scalarWhiteNoiseL2 g b]

theorem charFun_pair_scalarWhiteNoiseL2 {d : Nat}
    (f g : ScalarWhiteNoiseHilbert d) (t : WithLp 2 (ℝ × ℝ)) :
    charFun
      (Measure.map
        (fun ω =>
          WithLp.toLp 2 (scalarWhiteNoiseL2 d f ω, scalarWhiteNoiseL2 d g ω))
        (scalarWhiteNoiseMeasure d)) t =
    charFun
      (Measure.map
        (fun ω =>
          (WithLp.ofLp t).1 * scalarWhiteNoiseL2 d f ω +
            (WithLp.ofLp t).2 * scalarWhiteNoiseL2 d g ω)
        (scalarWhiteNoiseMeasure d)) 1 := by
  rw [charFun_apply, charFun_apply]
  rw [integral_map (aemeasurable_pair_scalarWhiteNoiseL2 f g)]
  · rw [integral_map
      (aemeasurable_scalarWhiteNoiseL2_linearCombination f g (WithLp.ofLp t).1
        (WithLp.ofLp t).2)]
    · apply integral_congr_ae
      filter_upwards with ω
      rw [WithLp.prod_inner_apply]
      simp [RCLike.inner_apply]
    · fun_prop
  · fun_prop

theorem norm_sq_smul_add_smul_of_inner_eq_zero
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (f g : H) (a b : ℝ) (hfg : ⟪f, g⟫_ℝ = 0) :
    ‖a • f + b • g‖ ^ (2 : Nat) =
      a ^ (2 : Nat) * ‖f‖ ^ (2 : Nat) +
        b ^ (2 : Nat) * ‖g‖ ^ (2 : Nat) := by
  have hinner : ⟪a • f, b • g⟫_ℝ = 0 := by
    rw [real_inner_smul_left, real_inner_smul_right, hfg]
    ring
  rw [norm_add_sq_real, hinner]
  rw [norm_smul, norm_smul]
  rw [show ‖a‖ = |a| by rfl, show ‖b‖ = |b| by rfl]
  rw [mul_pow, mul_pow, sq_abs, sq_abs]
  ring

/-- Orthogonal scalar white-noise evaluations are independent. -/
theorem indepFun_scalarWhiteNoiseL2_of_inner_eq_zero {d : Nat}
    (f g : ScalarWhiteNoiseHilbert d) (hfg : ⟪f, g⟫_ℝ = 0) :
    (scalarWhiteNoiseL2 d f) ⟂ᵢ[scalarWhiteNoiseMeasure d] (scalarWhiteNoiseL2 d g) := by
  rw [indepFun_iff_charFun_prod (aemeasurable_scalarWhiteNoiseL2 f)
    (aemeasurable_scalarWhiteNoiseL2 g)]
  intro t
  let a : ℝ := (WithLp.ofLp t).1
  let b : ℝ := (WithLp.ofLp t).2
  have hnorm := norm_sq_smul_add_smul_of_inner_eq_zero f g a b hfg
  have hf_nonneg : 0 ≤ ‖f‖ ^ (2 : Nat) := sq_nonneg _
  have hg_nonneg : 0 ≤ ‖g‖ ^ (2 : Nat) := sq_nonneg _
  have hsum_nonneg :
      0 ≤ a ^ (2 : Nat) * ‖f‖ ^ (2 : Nat) +
        b ^ (2 : Nat) * ‖g‖ ^ (2 : Nat) := by
    exact add_nonneg (mul_nonneg (sq_nonneg _) hf_nonneg)
      (mul_nonneg (sq_nonneg _) hg_nonneg)
  calc
    charFun
        (Measure.map
          (fun ω =>
            WithLp.toLp 2 (scalarWhiteNoiseL2 d f ω, scalarWhiteNoiseL2 d g ω))
          (scalarWhiteNoiseMeasure d)) t
        = charFun
          (Measure.map
            (fun ω => a * scalarWhiteNoiseL2 d f ω + b * scalarWhiteNoiseL2 d g ω)
            (scalarWhiteNoiseMeasure d)) 1 := by
          simpa [a, b] using charFun_pair_scalarWhiteNoiseL2 f g t
    _ = charFun
          (ProbabilityTheory.gaussianReal 0
            (Real.toNNReal (‖a • f + b • g‖ ^ (2 : Nat)))) 1 :=
          charFun_scalarWhiteNoiseL2_linearCombination f g a b
    _ = charFun (Measure.map (scalarWhiteNoiseL2 d f) (scalarWhiteNoiseMeasure d)) a *
          charFun (Measure.map (scalarWhiteNoiseL2 d g) (scalarWhiteNoiseMeasure d)) b := by
          rw [map_scalarWhiteNoiseL2_eq_gaussianReal f,
            map_scalarWhiteNoiseL2_eq_gaussianReal g]
          rw [ProbabilityTheory.charFun_gaussianReal,
            ProbabilityTheory.charFun_gaussianReal,
            ProbabilityTheory.charFun_gaussianReal]
          rw [hnorm]
          rw [Real.coe_toNNReal _ hsum_nonneg,
            Real.coe_toNNReal _ hf_nonneg,
            Real.coe_toNNReal _ hg_nonneg]
          simp only [Complex.ofReal_zero, Complex.ofReal_one, zero_mul, one_mul]
          rw [← Complex.exp_add]
          congr 1
          push_cast
          ring

/-- Every finite deterministic linear combination of scalar white-noise evaluations is Gaussian. -/
theorem map_sum_scalarWhiteNoiseL2_eq_gaussianReal {d : Nat} {ι : Type*}
    (s : Finset ι) (a : ι → ℝ) (f : ι → ScalarWhiteNoiseHilbert d) :
    Measure.map
        (⇑(∑ i ∈ s, a i • scalarWhiteNoiseL2 d (f i) :
          Lp ℝ 2 (scalarWhiteNoiseMeasure d)))
        (scalarWhiteNoiseMeasure d) =
      ProbabilityTheory.gaussianReal 0
        (Real.toNNReal (‖∑ i ∈ s, a i • f i‖ ^ (2 : Nat))) := by
  have hsum :
      (∑ i ∈ s, a i • scalarWhiteNoiseL2 d (f i)) =
        scalarWhiteNoiseL2 d (∑ i ∈ s, a i • f i) := by
    simp [map_sum]
  rw [hsum, map_scalarWhiteNoiseL2_eq_gaussianReal]

@[simp]
theorem scalarWhiteNoiseL2_haarBasisLp {d : Nat} (idx : HaarBasisIndex d) :
    scalarWhiteNoiseL2 d (haarBasisLp idx) = gaussianCoordinateLp idx := by
  change gaussianL2Isometry (ι := HaarBasisIndex d)
      ((scalarWhiteNoiseHilbertBasis d).repr (haarBasisLp idx)) =
    gaussianCoordinateLp idx
  have hbasis : (scalarWhiteNoiseHilbertBasis d) idx = haarBasisLp idx := by
    simpa using congrFun (scalarWhiteNoiseHilbertBasis_coe d) idx
  rw [← hbasis, HilbertBasis.repr_self]
  simp

/-- The squared norm of a concrete real `L²` representative is its integral square. -/
theorem norm_toLp_sq_eq_integral_sq {d : Nat} {f : Vec d → ℝ}
    (hf : MemLp f 2 (volume : Measure (Vec d))) :
    ‖hf.toLp f‖ ^ (2 : Nat) =
      ∫ x, f x ^ (2 : Nat) ∂(volume : Measure (Vec d)) := by
  calc
    ‖hf.toLp f‖ ^ (2 : Nat) =
        ∫ x, (hf.toLp f x) ^ (2 : Nat) ∂(volume : Measure (Vec d)) := by
      rw [norm_sq_eq_re_inner (𝕜 := ℝ), MeasureTheory.L2.inner_def]
      simp
    _ = ∫ x, f x ^ (2 : Nat) ∂(volume : Measure (Vec d)) := by
      refine integral_congr_ae ?_
      exact hf.coeFn_toLp.mono fun x hx => by
        exact congrArg (fun y : ℝ => y ^ (2 : Nat)) hx

/-- Function-level law for a concrete representative `f` with `f ∈ L²(R^d)`. -/
theorem map_scalarWhiteNoiseL2_toLp_eq_gaussianReal {d : Nat} {f : Vec d → ℝ}
    (hf : MemLp f 2 (volume : Measure (Vec d))) :
    Measure.map (scalarWhiteNoiseL2 d (hf.toLp f)) (scalarWhiteNoiseMeasure d) =
      ProbabilityTheory.gaussianReal 0
        (Real.toNNReal (∫ x, f x ^ (2 : Nat) ∂(volume : Measure (Vec d)))) := by
  rw [map_scalarWhiteNoiseL2_eq_gaussianReal, norm_toLp_sq_eq_integral_sq hf]

